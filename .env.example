# --- Crawler + Agent API (Vercel > Settings > Environment Variables) ---
# Key cho AI agent gọi /api/agent/* (tự sinh: openssl rand -hex 32)
AGENT_API_KEY=
# (tuỳ chọn) Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>" tới /api/agent/crawl
CRON_SECRET=
# Quyền ghi Firebase — chọn 1:
#  (1) service account: Firebase Console > Project settings > Service accounts > Generate new private key
#      dán nguyên JSON (hoặc base64 của JSON)
FIREBASE_SERVICE_ACCOUNT=
#  (2) hoặc tài khoản admin (uid = ADMIN_UID trong rules)
FIREBASE_ADMIN_EMAIL=
FIREBASE_ADMIN_PASSWORD=
