# VPS dự phòng (Coolify): chạy nguyên app Next, tự lưu bản sao bảng giá vào /data.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_FALLBACK_ORIGIN=
ENV NEXT_PUBLIC_FALLBACK_ORIGIN=$NEXT_PUBLIC_FALLBACK_ORIGIN
RUN npx next build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 FALLBACK_CACHE_DIR=/data
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
VOLUME /data
EXPOSE 3000
CMD ["node", "server.js"]
