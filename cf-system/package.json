  },
  "dependencies": {
    
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.2.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.73.0"
  }
}
