{
  "name": "goldprice-cf-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-build": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && cd .build && next dev",
    "build": "node scripts/prepare.mjs && cd .build && next build",
    "cf:build": "node scripts/prepare.mjs && cd .build && opennextjs-cloudflare build",
